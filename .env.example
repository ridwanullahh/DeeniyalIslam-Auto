# =============================================================================
# DeeniyalIslam Auto — Environment Example
# Copy to .env and fill in real values. .env is gitignored.
# .env.example is committed to the repo on purpose (placeholders only).
# =============================================================================

# ---- App ----
APP_NAME="DeeniyalIslam Auto"
APP_URL="http://localhost:4321"
NODE_ENV="development"
# 32-byte random hex string. Generate with: openssl rand -hex 32
SESSION_SECRET="replace_me_with_32_bytes_of_random_hex"
# Comma-separated list of trusted proxy IPs / CIDRs that may set X-Forwarded-*.
TRUSTED_PROXIES="127.0.0.1,::1"

# ---- Admin Auth (env-based, multiple admins) ----
# Format: email:password,email2:password2,...
# Passwords should be Argon2id / bcrypt hashes in production, but plaintext also
# works for development. Hashes are auto-detected by leading "$2" / "$argon2".
ADMIN_CREDENTIALS="admin@deeniyalislam.auto:change_me_now"

# ---- Lightbase DB ----
LIGHTBASE_BASE_URL="http://lightbase.80.225.189.74.sslip.io"
LIGHTBASE_API_KEY="lb_live_replace_with_real_key"
LIGHTBASE_PROJECT_ID="deeniyalislam-auto"
LIGHTBASE_TENANT="default"
# Storage bucket name (created on bootstrap if missing)
LIGHTBASE_BUCKET="deeniyalislam-media"

# ---- WhatsApp (Bailey) ----
# Set to "true" to enable the WhatsApp bot worker on app start
WHATSAPP_ENABLED="true"
# Session id used for the auth state directory
WHATSAPP_SESSION_ID="deeniyalislam-auto"

# ---- Telegram ----
TELEGRAM_ENABLED="false"
TELEGRAM_BOT_TOKEN=""

# ---- Discord ----
DISCORD_ENABLED="false"
DISCORD_BOT_TOKEN=""

# ---- Facebook Messenger ----
MESSENGER_ENABLED="false"
MESSENGER_APP_SECRET=""
MESSENGER_ACCESS_TOKEN=""
MESSENGER_VERIFY_TOKEN=""

# ---- Scheduler ----
# Run the scheduler worker in-process (true) or as a separate process (false)
SCHEDULER_ENABLED="true"
# Poll interval in seconds
SCHEDULER_POLL_INTERVAL_SEC="30"

# ---- Cloudinary (Mushaf media library) ----
# Get credentials at https://cloudinary.com/console
# When disabled, the platform falls back to Lightbase storage for media.
CLOUDINARY_ENABLED="false"
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
CLOUDINARY_MUSHAF_FOLDER="deeniyalislam/mushaf"

# ---- Solah Times API (Aladhan — free, no key required) ----
SOLAH_API_BASE="https://api.aladhan.com/v1"
# Calculation method (see Aladhan docs):
#   2 = ISNA, 3 = Muslim World League (default), 4 = Umm Al-Qura, 5 = Egyptian,
#   9 = Karachi, 13 = Diyanet, 23 = Dubai
SOLAH_METHOD="3"
# Asr school: 0 = Shafi (standard), 1 = Hanafi
SOLAH_SCHOOL="0"

# ---- ToS-compliance guardrails (prevent platform bans) ----
# Max outbound messages per subscriber per hour (WhatsApp best practice ~12/hr)
GUARD_MAX_PER_SUB_HOUR="12"
# Max outbound messages per subscriber per day
GUARD_MAX_PER_SUB_DAY="60"
# Min delay between consecutive sends to the same subscriber (seconds)
GUARD_MIN_DELAY_SEC="60"
# Max messages per minute to a single channel globally
GUARD_MAX_CHANNEL_PER_MIN="30"

# ---- Brand ----
BRAND_PRIMARY="#05B34D"
BRAND_ACCENT="#F2B91C"
BRAND_DARK="#181F25"
BRAND_LIGHT_BG="#E9FBF1"
BRAND_WHITE="#FFFFFF"

# ---- Logging ----
LOG_LEVEL="info"

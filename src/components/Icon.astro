  width={size}
  height={size}
  viewBox="0 0 24 24"
  fill={isFill ? "currentColor" : "none"}
  stroke={isFill ? "none" : "currentColor"}
  stroke-width={strokeWidth}
  stroke-linecap="round"
  stroke-linejoin="round"
  class={cls}
  aria-hidden="true"
  set:html={`<path d="${d}" />`}
/>

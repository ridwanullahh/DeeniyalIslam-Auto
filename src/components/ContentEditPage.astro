---
/**
 * ContentEditPage.astro — generic form for create/edit of content types.
 * Renders fields defined in the page's frontmatter.
 */
import AdminLayout from "@/layouts/AdminLayout.astro";
import Icon from "@/components/Icon.astro";
import { collections } from "@/lib/lightbase/client";

interface Field {
  name: string;
  label: string;
  type: "text" | "textarea" | "number" | "select" | "tags";
  required?: boolean;
  placeholder?: string;
  options?: Array<{ value: string; label: string }>;
  rtl?: boolean;
  rows?: number;
  default?: string | number | boolean | string[];
}

interface Props {
  title: string;
  backHref: string;
  apiUrl: string;
  editHrefPrefix: string;
  auditLabel: string;
  fields: Field[];
  collection: string;
}

const {
  title,
  backHref,
  apiUrl,
  editHrefPrefix,
  auditLabel,
  fields,
  collection,
} = Astro.props;

const id = Astro.params.id;
const isEdit = !!id && id !== "new";

let doc: any = null;
if (isEdit && id) {
  try {
    doc = await collections(collection).get(id);
    if (!doc) return Astro.redirect(backHref, 302);
  } catch (e) {
    return Astro.redirect(backHref, 302);
  }
}

function fieldValue(name: string): string {
  if (!doc) return "";
  const v = doc[name];
  if (v === null || v === undefined) return "";
  if (Array.isArray(v)) return v.join(", ");
  return String(v);
}
---

<AdminLayout title={isEdit ? `Edit ${auditLabel}` : `New ${auditLabel}`} activeNav="content">
  <div class="form-page">
    <a href={backHref} class="back-link">
      <Icon name="arrow_left" size={14} />
      Back to {auditLabel.toLowerCase()}s
    </a>

    <form id="content-form" class="form card">
      <input type="hidden" name="id" value={id ?? ""} />

      {fields.map((field) => (
        <label class="field">
          <span class="field__label">{field.label}{field.required && <span class="req">*</span>}</span>
          {field.type === "textarea" ? (
            <textarea
              name={field.name}
              required={field.required}
              rows={field.rows ?? 3}
              class:list={["textarea", field.rtl && "font-arabic"]}
              dir={field.rtl ? "rtl" : "ltr"}
              lang={field.rtl ? "ar" : "en"}
              placeholder={field.placeholder ?? ""}
            >{fieldValue(field.name)}</textarea>
          ) : field.type === "select" ? (
            <select name={field.name} required={field.required} class="select">
              {!field.required && <option value="">— None —</option>}
              {field.options?.map((opt) => (
                <option value={opt.value} selected={fieldValue(field.name) === opt.value}>{opt.label}</option>
              ))}
            </select>
          ) : field.type === "tags" ? (
            <input
              type="text"
              name={field.name}
              class="input"
              placeholder={field.placeholder ?? "comma, separated, tags"}
              value={fieldValue(field.name)}
            />
          ) : (
            <input
              type={field.type}
              name={field.name}
              required={field.required}
              class:list={["input", field.rtl && "font-arabic"]}
              dir={field.rtl ? "rtl" : "ltr"}
              lang={field.rtl ? "ar" : "en"}
              placeholder={field.placeholder ?? ""}
              value={fieldValue(field.name)}
              step={field.type === "number" ? "1" : undefined}
              min={field.type === "number" ? "0" : undefined}
            />
          )}
        </label>
      ))}

      <div id="form-error" class="form-error" hidden></div>

      <div class="form-actions">
        {isEdit && (
          <button type="button" class="btn btn-danger" id="delete-btn">
            <Icon name="trash" size={16} />
            Delete
          </button>
        )}
        <button type="submit" class="btn btn-primary" id="submit-btn">
          <Icon name="check" size={16} />
          {isEdit ? "Save changes" : `Create ${auditLabel.toLowerCase()}`}
        </button>
      </div>
    </form>
  </div>
</AdminLayout>

<style>
  .form-page { max-width: 760px; margin: 0 auto; }
  .back-link {
    display: inline-flex;
    align-items: center;
    gap: 0.25rem;
    color: var(--fg-muted);
    font-size: 0.875rem;
    text-decoration: none;
    margin-bottom: 0.875rem;
  }
  .back-link:hover { color: var(--primary-strong); }

  .form {
    padding: 1.25rem;
    display: flex;
    flex-direction: column;
    gap: 0.875rem;
  }
  .field { display: flex; flex-direction: column; gap: 0.375rem; }
  .field__label {
    font-size: 0.8rem;
    font-weight: 600;
    color: var(--fg-muted);
  }
  .req { color: var(--danger); margin-left: 0.25rem; }
  .form-error {
    background: var(--danger-soft);
    color: var(--danger);
    padding: 0.75rem 1rem;
    border-radius: var(--radius-md);
    font-size: 0.875rem;
    border: 1px solid color-mix(in srgb, var(--danger) 30%, transparent);
  }
  .form-actions {
    display: flex;
    justify-content: space-between;
    gap: 0.625rem;
    padding-top: 0.5rem;
    border-top: 1px solid var(--border);
  }
</style>

<script define:vars={{ isEdit, id, apiUrl, fields }}>
  const form = document.getElementById("content-form");
  const errorBox = document.getElementById("form-error");
  const submitBtn = document.getElementById("submit-btn");
  const deleteBtn = document.getElementById("delete-btn");

  function collectBody() {
    const fd = new FormData(form);
    const body = {};
    for (const field of fields) {
      const raw = fd.get(field.name);
      if (field.type === "number") {
        if (raw === "" || raw === null || raw === undefined) continue;
        body[field.name] = Number(raw);
      } else if (field.type === "tags") {
        body[field.name] = (raw || "").split(",").map(s => s.trim()).filter(Boolean);
      } else {
        if (raw === null || raw === undefined) continue;
        if (raw !== "") body[field.name] = raw;
        else if (field.required === true) body[field.name] = raw;
      }
    }
    return body;
  }

  async function submitForm(e) {
    e.preventDefault();
    if (errorBox) errorBox.hidden = true;
    if (submitBtn) submitBtn.disabled = true;
    const body = collectBody();
    try {
      const url = isEdit ? `${apiUrl}/${id}` : apiUrl;
      const method = isEdit ? "PATCH" : "POST";
      const res = await fetch(url, {
        method,
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify(body),
      });
      const data = await res.json();
      if (!res.ok || !data.ok) throw new Error(data.error || `Failed: ${res.status}`);
      window.location.href = form.querySelector(".back-link")?.getAttribute("href") || "/admin";
    } catch (err) {
      if (errorBox) {
        errorBox.textContent = err.message || "Failed to save";
        errorBox.hidden = false;
      }
      if (submitBtn) submitBtn.disabled = false;
    }
  }

  async function deleteItem() {
    if (!isEdit || !id) return;
    if (!confirm("Are you sure you want to delete this item? This cannot be undone.")) return;
    try {
      const res = await fetch(`${apiUrl}/${id}`, { method: "DELETE" });
      if (!res.ok) {
        const data = await res.json();
        throw new Error(data.error || `Failed: ${res.status}`);
      }
      window.location.href = form.querySelector(".back-link")?.getAttribute("href") || "/admin";
    } catch (err) {
      if (errorBox) {
        errorBox.textContent = err.message || "Failed to delete";
        errorBox.hidden = false;
      }
    }
  }

  form?.addEventListener("submit", submitForm);
  deleteBtn?.addEventListener("click", deleteItem);
</script>

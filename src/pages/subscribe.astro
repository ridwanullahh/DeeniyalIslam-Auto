---
/**
 * /subscribe — public subscribe page. User selects platform, content types,
 * schedule, timezone. POSTs to /api/subscribers which creates the subscriber
 * + subscriptions in Lightbase.
 */
import BaseLayout from "@/layouts/BaseLayout.astro";
import Icon from "@/components/Icon.astro";
---

<BaseLayout title="Subscribe" activeNav="subscribe">
  <div class="subscribe-page">
    <header class="sub-head">
      <div class="sub-head__icon">
        <Icon name="bell" size={28} />
      </div>
      <h1>Get reminders in your inbox</h1>
      <p>Choose what, when, and where — we'll handle the rest, bi'idniLlah.</p>
    </header>

    <form id="subscribe-form" class="form">
      <!-- Step 1: Channel -->
      <fieldset class="card step">
        <legend class="step__num">1</legend>
        <div class="step__body">
          <h2 class="step__title">Choose your channel</h2>
          <p class="step__desc">Where do you want to receive reminders?</p>
          <div class="channel-grid">
            <label class="channel-option">
              <input type="radio" name="platform" value="whatsapp" required checked />
              <div class="channel-option__inner">
                <Icon name="whatsapp" size={24} />
                <span>WhatsApp</span>
              </div>
            </label>
            <label class="channel-option">
              <input type="radio" name="platform" value="telegram" />
              <div class="channel-option__inner">
                <Icon name="telegram" size={24} />
                <span>Telegram</span>
              </div>
            </label>
            <label class="channel-option">
              <input type="radio" name="platform" value="discord" />
              <div class="channel-option__inner">
                <Icon name="discord" size={24} />
                <span>Discord</span>
              </div>
            </label>
            <label class="channel-option">
              <input type="radio" name="platform" value="messenger" />
              <div class="channel-option__inner">
                <Icon name="messenger" size={24} />
                <span>Messenger</span>
              </div>
            </label>
          </div>

          <label class="field" id="phone-field">
            <span class="field__label">WhatsApp number (E.164)</span>
            <input type="tel" name="handle" class="input" placeholder="+234 803 123 4567" />
            <span class="field__hint">Include country code. We'll send a verification message to this number.</span>
          </label>
        </div>
      </fieldset>

      <!-- Step 2: Content -->
      <fieldset class="card step">
        <legend class="step__num">2</legend>
        <div class="step__body">
          <h2 class="step__title">What should we send you?</h2>
          <p class="step__desc">Pick as many as you like.</p>
          <div class="content-picks">
            <label class="content-pick">
              <input type="checkbox" name="content" value="quran_verse" checked />
              <div class="content-pick__inner">
                <Icon name="book" size={18} />
                <div>
                  <div class="content-pick__title">Qur'an verse</div>
                  <div class="content-pick__desc">A daily verse with translation</div>
                </div>
              </div>
            </label>
            <label class="content-pick">
              <input type="checkbox" name="content" value="hadith" />
              <div class="content-pick__inner">
                <Icon name="users" size={18} />
                <div>
                  <div class="content-pick__title">Hadith</div>
                  <div class="content-pick__desc">A daily authentic narration</div>
                </div>
              </div>
            </label>
            <label class="content-pick">
              <input type="checkbox" name="content" value="adhkar_morning" checked />
              <div class="content-pick__inner">
                <Icon name="sun" size={18} />
                <div>
                  <div class="content-pick__title">Morning Adhkar</div>
                  <div class="content-pick__desc">Sunnah remembrances after Fajr</div>
                </div>
              </div>
            </label>
            <label class="content-pick">
              <input type="checkbox" name="content" value="adhkar_evening" />
              <div class="content-pick__inner">
                <Icon name="moon" size={18} />
                <div>
                  <div class="content-pick__title">Evening Adhkar</div>
                  <div class="content-pick__desc">Sunnah remembrances after Asr</div>
                </div>
              </div>
            </label>
            <label class="content-pick">
              <input type="checkbox" name="content" value="adhkar_sleep" />
              <div class="content-pick__inner">
                <Icon name="bookmark" size={18} />
                <div>
                  <div class="content-pick__title">Sleep Adhkar</div>
                  <div class="content-pick__desc">Before sleeping at night</div>
                </div>
              </div>
            </label>
            <label class="content-pick">
              <input type="checkbox" name="content" value="adhkar_after_prayer" />
              <div class="content-pick__inner">
                <Icon name="check" size={18} />
                <div>
                  <div class="content-pick__title">After-Prayer Adhkar</div>
                  <div class="content-pick__desc">After each obligatory prayer</div>
                </div>
              </div>
            </label>
            <label class="content-pick">
              <input type="checkbox" name="content" value="general_reminder" />
              <div class="content-pick__inner">
                <Icon name="sparkles" size={18} />
                <div>
                  <div class="content-pick__title">Daily Reminder</div>
                  <div class="content-pick__desc">A short reflection from the Sunnah</div>
                </div>
              </div>
            </label>
          </div>
        </div>
      </fieldset>

      <!-- Step 3: Schedule -->
      <fieldset class="card step">
        <legend class="step__num">3</legend>
        <div class="step__body">
          <h2 class="step__title">When should we send them?</h2>
          <p class="step__desc">We'll deliver at your local time.</p>

          <label class="field">
            <span class="field__label">Your timezone</span>
            <select name="timezone" class="select" id="timezone-select">
              <option value="Africa/Lagos">Africa/Lagos (WAT)</option>
            </select>
          </label>

          <label class="field">
            <span class="field__label">Delivery time</span>
            <select name="deliveryTime" class="select" id="delivery-time">
              <option value="05:30">05:30 — After Fajr (morning)</option>
              <option value="06:00">06:00 — Morning</option>
              <option value="07:00">07:00 — Morning</option>
              <option value="08:00">08:00 — Morning</option>
              <option value="12:00">12:00 — Midday</option>
              <option value="15:30">15:30 — After Asr (evening)</option>
              <option value="17:00">17:00 — Evening</option>
              <option value="18:00">18:00 — Evening</option>
              <option value="21:00">21:00 — Before sleep</option>
              <option value="22:00">22:00 — Before sleep</option>
            </select>
          </label>
        </div>
      </fieldset>

      <div id="form-error" class="form-error" hidden></div>

      <button type="submit" class="btn btn-primary submit-btn" id="submit-btn">
        <Icon name="check" size={18} />
        Subscribe
      </button>
    </form>

    <div id="success-screen" class="card success-screen" hidden>
      <div class="success-screen__icon">
        <Icon name="check" size={32} />
      </div>
      <h2>Bismillah — you're subscribed!</h2>
      <p id="success-msg">We've saved your preferences. Your first reminder will arrive at the scheduled time, in shaa Allah.</p>
      <a href="/" class="btn btn-outline">
        <Icon name="home" size={16} />
        Back to home
      </a>
    </div>
  </div>
</BaseLayout>

<style>
  .subscribe-page {
    max-width: 640px;
    margin: 0 auto;
    padding: 1rem 0 3rem;
  }

  .sub-head {
    text-align: center;
    margin-bottom: 1.5rem;
  }
  .sub-head__icon {
    width: 64px;
    height: 64px;
    border-radius: 18px;
    background: linear-gradient(135deg, var(--primary), var(--primary-strong));
    color: #fff;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    margin-bottom: 0.875rem;
    box-shadow: 0 8px 24px color-mix(in srgb, var(--primary) 30%, transparent);
  }
  .sub-head h1 {
    font-size: 1.5rem;
    margin-bottom: 0.375rem;
    letter-spacing: -0.02em;
  }
  .sub-head p {
    color: var(--fg-muted);
    font-size: 0.9rem;
  }

  .form {
    display: flex;
    flex-direction: column;
    gap: 0.875rem;
  }

  .step {
    border: none;
    padding: 0;
    margin: 0;
    position: relative;
    padding-left: 2.75rem;
  }
  .step__num {
    position: absolute;
    top: 1rem;
    left: 1rem;
    width: 28px;
    height: 28px;
    border-radius: 50%;
    background: var(--primary);
    color: #fff;
    font-size: 0.85rem;
    font-weight: 700;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 0;
    margin: 0;
  }
  .step__body {
    padding: 1rem 1.125rem 1.125rem;
  }
  .step__title {
    font-size: 1rem;
    margin-bottom: 0.25rem;
  }
  .step__desc {
    font-size: 0.8rem;
    color: var(--fg-muted);
    margin-bottom: 0.875rem;
  }

  .channel-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 0.5rem;
    margin-bottom: 0.875rem;
  }
  .channel-option {
    cursor: pointer;
  }
  .channel-option input {
    position: absolute;
    opacity: 0;
    pointer-events: none;
  }
  .channel-option__inner {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.375rem;
    padding: 0.875rem 0.5rem;
    border: 1.5px solid var(--border-strong);
    border-radius: var(--radius-md);
    color: var(--fg-muted);
    transition: border 0.15s, color 0.15s, background 0.15s;
    text-align: center;
  }
  .channel-option input:checked + .channel-option__inner {
    border-color: var(--primary);
    color: var(--primary-strong);
    background: var(--success-soft);
  }

  .field {
    display: flex;
    flex-direction: column;
    gap: 0.375rem;
    margin-bottom: 0.875rem;
  }
  .field:last-child { margin-bottom: 0; }
  .field__label {
    font-size: 0.8rem;
    font-weight: 600;
    color: var(--fg-muted);
  }
  .field__hint {
    font-size: 0.7rem;
    color: var(--fg-faint);
  }

  .content-picks {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }
  .content-pick {
    cursor: pointer;
  }
  .content-pick input {
    position: absolute;
    opacity: 0;
    pointer-events: none;
  }
  .content-pick__inner {
    display: flex;
    align-items: center;
    gap: 0.625rem;
    padding: 0.75rem 0.875rem;
    border: 1.5px solid var(--border-strong);
    border-radius: var(--radius-md);
    color: var(--fg-muted);
    transition: border 0.15s, color 0.15s, background 0.15s;
  }
  .content-pick input:checked + .content-pick__inner {
    border-color: var(--primary);
    color: var(--primary-strong);
    background: var(--success-soft);
  }
  .content-pick__title {
    font-size: 0.9rem;
    font-weight: 600;
  }
  .content-pick__desc {
    font-size: 0.75rem;
    color: var(--fg-faint);
  }

  .form-error {
    background: var(--danger-soft);
    color: var(--danger);
    padding: 0.75rem 1rem;
    border-radius: var(--radius-md);
    font-size: 0.875rem;
    border: 1px solid color-mix(in srgb, var(--danger) 30%, transparent);
  }

  .submit-btn {
    width: 100%;
    height: 52px;
    font-size: 1rem;
  }

  .success-screen {
    padding: 2rem 1.25rem;
    text-align: center;
    margin-top: 1rem;
  }
  .success-screen__icon {
    width: 64px;
    height: 64px;
    border-radius: 50%;
    background: var(--primary);
    color: #fff;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    margin-bottom: 1rem;
    box-shadow: 0 8px 24px color-mix(in srgb, var(--primary) 35%, transparent);
    animation: pop 0.4s var(--ease-spring);
  }
  @keyframes pop {
    0% { transform: scale(0); }
    100% { transform: scale(1); }
  }
  .success-screen h2 {
    font-size: 1.25rem;
    margin-bottom: 0.5rem;
  }
  .success-screen p {
    color: var(--fg-muted);
    font-size: 0.9rem;
    margin-bottom: 1.25rem;
    line-height: 1.55;
  }
</style>

<script>
  // Populate timezone select with all IANA zones (browser Intl.supportedValuesOf)
  const tzSelect = document.getElementById("timezone-select");
  try {
    const zones = (Intl.supportedValuesOf?.("timeZone") || []);
    // Try to detect user timezone
    const userTz = Intl.DateTimeFormat().resolvedOptions().timeZone;
    if (zones.length > 0) {
      tzSelect.innerHTML = zones.map((tz) => {
        const sel = tz === userTz ? "selected" : "";
        return `<option value="${tz}" ${sel}>${tz}</option>`;
      }).join("");
    }
  } catch (e) {
    // Fallback to a small set
  }

  // Convert local HH:MM to UTC cron expression based on timezone
  function localTimeToUtcCron(localHhmm, timezone) {
    const [h, m] = localHhmm.split(":").map(Number);
    // We use Intl to compute the offset right now (DST-aware for today)
    const now = new Date();
    const localStr = new Intl.DateTimeFormat("en-US", {
      timeZone: timezone, hour12: false,
      year: "numeric", month: "2-digit", day: "2-digit",
      hour: "2-digit", minute: "2-digit",
    }).formatToParts(now);
    const parts = {};
    localStr.forEach((p) => { parts[p.type] = p.value; });
    const tzDate = new Date(`${parts.year}-${parts.month}-${parts.day}T${parts.hour === "24" ? "00" : parts.hour}:${parts.minute}:00Z`);
    const offsetMs = tzDate.getTime() - now.getTime();
    const offsetH = Math.round(offsetMs / 3600000);
    let utcH = (h - offsetH + 24) % 24;
    return `${m} ${utcH} * * *`;
  }

  const form = document.getElementById("subscribe-form");
  const errorBox = document.getElementById("form-error");
  const submitBtn = document.getElementById("submit-btn");
  const successScreen = document.getElementById("success-screen");

  form?.addEventListener("submit", async (e) => {
    e.preventDefault();
    if (errorBox) errorBox.hidden = true;
    if (submitBtn) {
      submitBtn.disabled = true;
      submitBtn.innerHTML = `<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" style="animation: spin 0.8s linear infinite"><path d="M21 12a9 9 0 1 1-6.219-8.56"/></svg> Subscribing…`;
    }
    const fd = new FormData(form);
    const platform = fd.get("platform");
    const handle = fd.get("handle")?.trim();
    const timezone = fd.get("timezone");
    const deliveryTime = fd.get("deliveryTime");
    const contents = fd.getAll("content");

    if (!handle) {
      if (errorBox) {
        errorBox.textContent = "Please enter your " + platform + " handle.";
        errorBox.hidden = false;
      }
      if (submitBtn) {
        submitBtn.disabled = false;
        submitBtn.innerHTML = `<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M4 12l5 5L20 6"/></svg> Subscribe`;
      }
      return;
    }
    if (contents.length === 0) {
      if (errorBox) {
        errorBox.textContent = "Please select at least one content type.";
        errorBox.hidden = false;
      }
      if (submitBtn) {
        submitBtn.disabled = false;
        submitBtn.innerHTML = `<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M4 12l5 5L20 6"/></svg> Subscribe`;
      }
      return;
    }

    // Compute UTC cron for each content type
    const subscriptions = contents.map((contentType) => {
      const cron = localTimeToUtcCron(deliveryTime, timezone);
      return { contentType, scheduleCron: cron };
    });

    try {
      const res = await fetch("/api/subscribers", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({ platform, handle, timezone, language: "en", subscriptions }),
      });
      const data = await res.json();
      if (!res.ok || !data.ok) throw new Error(data.error || `Failed: ${res.status}`);
      // Show success screen
      form.hidden = true;
      if (successScreen) {
        successScreen.hidden = false;
        const msgEl = document.getElementById("success-msg");
        const isUpdate = data.subscriber?.isUpdate;
        if (msgEl) {
          msgEl.textContent = isUpdate
            ? "We've updated your preferences. Your next reminder will arrive at the scheduled time, in shaa Allah."
            : "We've saved your preferences. Your first reminder will arrive at the scheduled time, in shaa Allah.";
        }
      }
      window.scrollTo({ top: 0, behavior: "smooth" });
    } catch (err) {
      if (errorBox) {
        errorBox.textContent = err.message || "Failed to subscribe";
        errorBox.hidden = false;
      }
      if (submitBtn) {
        submitBtn.disabled = false;
        submitBtn.innerHTML = `<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M4 12l5 5L20 6"/></svg> Subscribe`;
      }
    }
  });
</script>

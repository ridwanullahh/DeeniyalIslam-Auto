---
import BaseLayout from "@/layouts/BaseLayout.astro";
import Icon from "@/components/Icon.astro";
---

<BaseLayout title="Qur'an Reader" activeNav="quran">
  <div class="reader-page">
    <header class="reader-head">
      <h1>Mushaf Reader</h1>
      <p>Read the Qur'an page-by-page — Mushaf Madinah format.</p>
    </header>

    <div class="reader-controls">
      <button class="btn btn-outline" id="prev-page" aria-label="Previous page">
        <Icon name="chevron_left" size={16} />
        Prev
      </button>
      <div class="reader-progress">
        <span class="reader-progress__num">Page <span id="current-num">1</span> of 604</span>
        <input type="range" min="1" max="604" value="1" id="page-slider" class="reader-slider" />
      </div>
      <button class="btn btn-outline" id="next-page" aria-label="Next page">
        Next
        <Icon name="chevron_right" size={16} />
      </button>
    </div>

    <div class="reader-image-wrap" id="image-wrap">
      <div class="shimmer" style="aspect-ratio:3/4;max-width:480px;margin:0 auto;border-radius:8px"></div>
    </div>

    <div class="reader-actions">
      <a href="/subscribe" class="btn btn-primary">
        <Icon name="bell" size={16} />
        Subscribe for daily Khatma
      </a>
    </div>
  </div>
</BaseLayout>

<style>
  .reader-page { display: flex; flex-direction: column; gap: 0.875rem; }
  .reader-head { text-align: center; padding: 1rem 0 0.5rem; }
  .reader-head h1 { font-size: 1.75rem; letter-spacing: -0.02em; margin-bottom: 0.375rem; }
  .reader-head p { color: var(--fg-muted); font-size: 0.875rem; }

  .reader-controls {
    display: flex; align-items: center; gap: 0.625rem;
    padding: 0.625rem;
    background: var(--bg-elev); border: 1px solid var(--border);
    border-radius: var(--radius-md);
    position: sticky; top: 60px; z-index: 10;
  }
  .reader-progress { flex: 1; display: flex; flex-direction: column; gap: 0.375rem; align-items: center; }
  .reader-progress__num { font-size: 0.75rem; color: var(--fg-muted); font-weight: 600; }
  .reader-slider {
    width: 100%; max-width: 400px; height: 6px;
    -webkit-appearance: none; appearance: none;
    background: var(--bg-sunken); border-radius: 3px; outline: none;
  }
  .reader-slider::-webkit-slider-thumb {
    -webkit-appearance: none; appearance: none;
    width: 18px; height: 18px; border-radius: 50%;
    background: var(--primary); cursor: pointer;
  }
  .reader-slider::-moz-range-thumb {
    width: 18px; height: 18px; border-radius: 50%;
    background: var(--primary); cursor: pointer; border: none;
  }

  .reader-image-wrap {
    background: var(--bg-elev); border: 1px solid var(--border);
    border-radius: var(--radius-lg); padding: 1rem;
    text-align: center;
  }
  .reader-image-wrap img {
    max-width: 480px; width: 100%; height: auto;
    border-radius: var(--radius-md); display: block; margin: 0 auto;
    background: #fff;
  }

  .reader-actions {
    display: flex; justify-content: center; padding: 1rem 0 3rem;
  }
</style>

<script>
  let currentPage = 1;
  const TOTAL_PAGES = 604;
  const FALLBACK_BASE = "https://everyayah.com/data/mushaf/quran_madinah/page_";
  const imageWrap = document.getElementById("image-wrap");
  const currentNum = document.getElementById("current-num");
  const pageSlider = document.getElementById("page-slider") as HTMLInputElement;

  async function loadPage(num: number) {
    currentPage = num;
    if (currentNum) currentNum.textContent = String(num);
    if (pageSlider) pageSlider.value = String(num);
    imageWrap.innerHTML = `<div class="shimmer" style="aspect-ratio:3/4;max-width:480px;margin:0 auto;border-radius:8px"></div>`;
    try {
      // Try to fetch from our Mushaf library (admin-uploaded)
      const res = await fetch(`/api/public/mushaf?page=${num}`);
      const data = await res.json();
      let url: string;
      if (data.ok && data.page?.imageUrl) {
        url = data.page.imageUrl;
      } else {
        // Fallback to public everyayah.com images
        url = `${FALLBACK_BASE}${String(num).padStart(3, "0")}.png`;
      }
      const img = new Image();
      img.onload = () => {
        imageWrap.innerHTML = "";
        img.style.maxWidth = "480px";
        img.style.width = "100%";
        img.style.height = "auto";
        img.style.borderRadius = "var(--radius-md)";
        img.style.display = "block";
        img.style.margin = "0 auto";
        img.style.background = "#fff";
        imageWrap.appendChild(img);
      };
      img.onerror = () => {
        imageWrap.innerHTML = `<div style="padding:3rem 1rem;text-align:center;color:var(--fg-muted)">Could not load page ${num}.</div>`;
      };
      img.src = url;
      img.alt = `Mushaf page ${num}`;
    } catch (e) {
      imageWrap.innerHTML = `<div style="padding:3rem 1rem;text-align:center;color:var(--fg-muted)">Could not load page ${num}.</div>`;
    }
  }

  document.getElementById("prev-page")?.addEventListener("click", () => {
    if (currentPage > 1) loadPage(currentPage - 1);
  });
  document.getElementById("next-page")?.addEventListener("click", () => {
    if (currentPage < TOTAL_PAGES) loadPage(currentPage + 1);
  });
  pageSlider?.addEventListener("input", () => {
    const n = Number(pageSlider.value);
    if (n !== currentPage) loadPage(n);
  });

  // Keyboard nav
  document.addEventListener("keydown", (e) => {
    if (e.target instanceof HTMLInputElement) return;
    if (e.key === "ArrowLeft" && currentPage > 1) loadPage(currentPage - 1);
    if (e.key === "ArrowRight" && currentPage < TOTAL_PAGES) loadPage(currentPage + 1);
  });

  loadPage(1);
</script>

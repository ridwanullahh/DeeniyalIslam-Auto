---
/**
 * /admin/channels — view channel statuses, scheduler status, and WhatsApp QR.
 */
import AdminLayout from "@/layouts/AdminLayout.astro";
import Icon from "@/components/Icon.astro";
---

<AdminLayout title="Channels & Scheduler" activeNav="settings">
  <section class="card panel">
    <header class="panel__head">
      <h2><Icon name="clock" size={18} /> Scheduler</h2>
    </header>
    <div class="panel__body" id="scheduler-status">
      <div class="shimmer" style="height:60px;border-radius:8px"></div>
    </div>
  </section>

  <section class="card panel">
    <header class="panel__head">
      <h2><Icon name="send" size={18} /> Channels</h2>
      <button class="btn btn-outline btn-sm" id="refresh-channels">
        <Icon name="refresh" size={14} />
        Refresh
      </button>
    </header>
    <div class="panel__body" id="channels-list">
      <div class="shimmer" style="height:80px;border-radius:8px"></div>
    </div>
  </section>

  <section class="card panel" id="whatsapp-panel">
    <header class="panel__head">
      <h2><Icon name="whatsapp" size={18} /> WhatsApp Pairing</h2>
      <button class="btn btn-outline btn-sm" id="reconnect-whatsapp">
        <Icon name="refresh" size={14} />
        Reconnect
      </button>
    </header>
    <div class="panel__body" id="whatsapp-status">
      <div class="shimmer" style="height:100px;border-radius:8px"></div>
    </div>
  </section>
</AdminLayout>

<style>
  .panel { padding: 1rem 1.125rem; margin-bottom: 0.875rem; }
  .panel__head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 0.75rem;
    padding-bottom: 0.625rem;
    border-bottom: 1px solid var(--border);
  }
  .panel__head h2 {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 1rem;
    font-weight: 700;
  }
  .btn-sm { min-height: 36px; padding: 0.5rem 0.875rem; font-size: 0.8rem; }
  .panel__body { padding-top: 0.25rem; }

  .stat-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0.625rem 0;
    border-bottom: 1px solid var(--border);
  }
  .stat-row:last-child { border-bottom: none; }
  .stat-row__label { color: var(--fg-muted); font-size: 0.85rem; }
  .stat-row__value { font-weight: 600; font-size: 0.85rem; }

  .channel-row {
    display: flex;
    align-items: center;
    gap: 0.875rem;
    padding: 0.75rem 0;
    border-bottom: 1px solid var(--border);
  }
  .channel-row:last-child { border-bottom: none; }
  .channel-row__icon {
    width: 36px;
    height: 36px;
    border-radius: 10px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }
  .channel-row__icon--on { background: var(--success-soft); color: var(--primary-strong); }
  .channel-row__icon--off { background: var(--bg-sunken); color: var(--fg-faint); }
  .channel-row__info { flex: 1; min-width: 0; }
  .channel-row__name { font-weight: 600; font-size: 0.9rem; text-transform: capitalize; }
  .channel-row__detail { font-size: 0.75rem; color: var(--fg-muted); }
  .channel-row__badge {
    font-size: 0.7rem;
    font-weight: 700;
    padding: 0.25rem 0.5rem;
    border-radius: 999px;
    text-transform: uppercase;
  }
  .channel-row__badge--on { background: var(--success-soft); color: var(--primary-strong); }
  .channel-row__badge--off { background: var(--bg-sunken); color: var(--fg-faint); }

  .qr-panel {
    text-align: center;
    padding: 1.5rem 1rem;
  }
  .qr-panel img {
    width: 220px;
    height: 220px;
    margin: 0 auto 0.875rem;
    display: block;
    background: #fff;
    padding: 8px;
    border-radius: 12px;
  }
  .qr-panel__msg {
    color: var(--fg-muted);
    font-size: 0.85rem;
    margin-bottom: 0.5rem;
  }
  .qr-panel__sub {
    color: var(--fg-faint);
    font-size: 0.75rem;
  }

  .connected-state {
    padding: 2rem 1rem;
    text-align: center;
  }
  .connected-state__icon {
    width: 56px;
    height: 56px;
    border-radius: 50%;
    background: var(--primary);
    color: #fff;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    margin-bottom: 0.875rem;
  }
  .connected-state__title {
    font-size: 1rem;
    font-weight: 700;
    color: var(--primary-strong);
    margin-bottom: 0.25rem;
  }
  .connected-state__sub {
    color: var(--fg-muted);
    font-size: 0.85rem;
  }
</style>

<script>
  function escapeHtml(s) {
    return String(s ?? "").replace(/[&<>"']/g, (c) => ({
      "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;", "'": "&#39;",
    }[c]));
  }

  async function loadStatus() {
    try {
      const res = await fetch("/api/admin/channels", { headers: { Accept: "application/json" } });
      if (!res.ok) throw new Error(`HTTP ${res.status}`);
      const data = await res.json();
      if (!data.ok) throw new Error(data.error);

      // Scheduler status
      const schedEl = document.getElementById("scheduler-status");
      if (schedEl) {
        const s = data.scheduler;
        schedEl.innerHTML = `
          <div class="stat-row">
            <span class="stat-row__label">Status</span>
            <span class="stat-row__value" style="color: ${s.running ? "var(--primary-strong)" : "var(--fg-faint)"}">${s.running ? "Running" : "Stopped"}</span>
          </div>
          <div class="stat-row">
            <span class="stat-row__label">Last run</span>
            <span class="stat-row__value">${s.lastRunAt ? new Date(s.lastRunAt).toLocaleString() : "—"}</span>
          </div>
          <div class="stat-row">
            <span class="stat-row__label">Processed</span>
            <span class="stat-row__value">${s.processed}</span>
          </div>
          <div class="stat-row">
            <span class="stat-row__label">Sent / Failed</span>
            <span class="stat-row__value">${s.sent} / ${s.failed}</span>
          </div>
        `;
      }

      // Channels list
      const channelsEl = document.getElementById("channels-list");
      if (channelsEl) {
        channelsEl.innerHTML = data.channels.map((c) => `
          <div class="channel-row">
            <div class="channel-row__icon ${c.connected ? "channel-row__icon--on" : "channel-row__icon--off"}">
              ${svgIcon(c.name)}
            </div>
            <div class="channel-row__info">
              <div class="channel-row__name">${escapeHtml(c.name)}</div>
              <div class="channel-row__detail">${escapeHtml(c.detail || (c.enabled ? "Enabled" : "Disabled"))}</div>
            </div>
            <span class="channel-row__badge ${c.connected ? "channel-row__badge--on" : "channel-row__badge--off"}">
              ${c.connected ? "Connected" : (c.enabled ? "Pending" : "Off")}
            </span>
          </div>
        `).join("");
      }

      // WhatsApp pairing section
      const waEl = document.getElementById("whatsapp-status");
      if (waEl) {
        const wa = data.whatsapp;
        if (wa.connected) {
          waEl.innerHTML = `
            <div class="connected-state">
              <div class="connected-state__icon">
                <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 12l5 5L20 6"/></svg>
              </div>
              <div class="connected-state__title">WhatsApp connected</div>
              <div class="connected-state__sub">${escapeHtml(wa.identity ?? "Bot is live")}</div>
            </div>
          `;
        } else if (wa.detail?.includes("QR")) {
          // Need to fetch the QR — use a separate endpoint
          waEl.innerHTML = `
            <div class="qr-panel">
              <div class="qr-panel__msg">Scan this QR with WhatsApp to pair</div>
              <div class="qr-panel__sub">Open WhatsApp → Settings → Linked Devices → Link a Device</div>
              <div style="margin-top:1rem">
                <img src="/api/admin/whatsapp-qr?t=${Date.now()}" alt="WhatsApp QR code" />
              </div>
            </div>
          `;
        } else {
          waEl.innerHTML = `
            <div class="connected-state">
              <div class="connected-state__icon" style="background:var(--fg-faint)">
                <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M12 9v4M12 17v.5M3 12s4-7 10-7 10 7 10 7-4 7-10 7S3 12 3 12Z"/></svg>
              </div>
              <div class="connected-state__title" style="color:var(--fg-muted)">${escapeHtml(wa.detail || "Not connected")}</div>
              <div class="connected-state__sub">Click "Reconnect" to retry.</div>
            </div>
          `;
        }
      }
    } catch (e) {
      console.error(e);
    }
  }

  function svgIcon(name) {
    const icons = {
      whatsapp: '<svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M12 2a10 10 0 0 0-8.6 15l-1.4 5 5.1-1.3A10 10 0 1 0 12 2Z"/></svg>',
      telegram: '<svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M22 3L2 11l6 2 2 6 3-3 5 4 4-17Z"/></svg>',
      discord: '<svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M19.5 5.5A16 16 0 0 0 15.5 4l-.3.5a14 14 0 0 1 3.5 1.2 12 12 0 0 0-10.5 0A14 14 0 0 1 11.8 4.5L11.5 4A16 16 0 0 0 7.5 5.5 16.5 16.5 0 0 0 4 17a16 16 0 0 0 5 2.5l.5-.8c-1-.3-1.9-.8-2.7-1.4l.6-.4a11 11 0 0 0 9.4 0l.6.4c-.8.6-1.7 1.1-2.7 1.4l.5.8A16 16 0 0 0 22 17a16.5 16.5 0 0 0-3.5-11.5ZM9.5 15a1.5 1.5 0 1 1 0-3 1.5 1.5 0 0 1 0 3Zm5 0a1.5 1.5 0 1 1 0-3 1.5 1.5 0 0 1 0 3Z"/></svg>',
      messenger: '<svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M12 2a10 10 0 0 0-9 14l-1 5 5-1A10 10 0 1 0 12 2Zm5 7l-2 5-2-2-3 2 2-5 2 2 3-2Z"/></svg>',
    };
    return icons[name] || icons.whatsapp;
  }

  document.getElementById("refresh-channels")?.addEventListener("click", loadStatus);
  document.getElementById("reconnect-whatsapp")?.addEventListener("click", async () => {
    try {
      await fetch("/api/admin/channels?action=reconnect-whatsapp", { method: "POST" });
      setTimeout(loadStatus, 1000);
    } catch (e) {
      console.error(e);
    }
  });

  loadStatus();
  setInterval(loadStatus, 5000);
</script>

---
import AdminLayout from "@/layouts/AdminLayout.astro";
import Icon from "@/components/Icon.astro";

const PLATFORMS = [
  { value: "", label: "All platforms" },
  { value: "whatsapp", label: "WhatsApp" },
  { value: "telegram", label: "Telegram" },
  { value: "discord", label: "Discord" },
  { value: "messenger", label: "Messenger" },
];
const STATUSES = [
  { value: "", label: "All statuses" },
  { value: "active", label: "Active" },
  { value: "paused", label: "Paused" },
  { value: "unsubscribed", label: "Unsubscribed" },
  { value: "blacklisted", label: "Blacklisted" },
];
---

<AdminLayout title="Subscribers" activeNav="subscribers">
  <div class="content-list-page">
    <div class="page-head">
      <span class="chip chip-primary">
        <Icon name="users" size={12} />
        <span class="count-chip">…</span> subscribers
      </span>
    </div>

    <div class="filter-bar">
      <div class="search-input">
        <Icon name="search" size={16} />
        <input type="search" id="search" placeholder="Search by handle or name…" autocomplete="off" />
      </div>
      <select class="select" id="platform-filter">
        {PLATFORMS.map((p) => <option value={p.value}>{p.label}</option>)}
      </select>
      <select class="select" id="status-filter">
        {STATUSES.map((s) => <option value={s.value}>{s.label}</option>)}
      </select>
    </div>

    <div class="list" id="subs-list">
      <div class="card shimmer-card" style="padding:1.5rem"><div class="shimmer" style="height:14px;width:60%;border-radius:4px"></div></div>
    </div>

    <div class="pagination" id="pagination" hidden>
      <button class="btn btn-outline" id="load-more">Load more</button>
    </div>
  </div>

  <div class="modal-backdrop" id="modal-backdrop" hidden></div>
  <div class="modal" id="sub-modal" hidden>
    <div class="modal__head">
      <h3>Subscriber details</h3>
      <button id="close-modal" class="modal__close" aria-label="Close"><Icon name="close" size={20} /></button>
    </div>
    <div class="modal__body" id="modal-body"></div>
  </div>
</AdminLayout>

<style>
  .content-list-page { display: flex; flex-direction: column; gap: 0.875rem; }
  .page-head { display: flex; align-items: center; justify-content: space-between; }
  .filter-bar { display: flex; flex-direction: column; gap: 0.5rem; }
  .search-input {
    display: flex; align-items: center; gap: 0.5rem;
    padding: 0 0.875rem; background: var(--bg-elev);
    border: 1.5px solid var(--border-strong); border-radius: var(--radius-md);
    color: var(--fg-faint); min-height: 44px;
  }
  .search-input:focus-within { border-color: var(--primary); color: var(--primary-strong); }
  .search-input input { flex: 1; border: none; outline: none; background: transparent; color: var(--fg); font-size: 0.95rem; }
  .list { display: flex; flex-direction: column; gap: 0.5rem; }

  .sub-card {
    padding: 0.875rem 1rem;
    display: flex;
    align-items: center;
    gap: 0.75rem;
    cursor: pointer;
    transition: border 0.15s;
  }
  .sub-card:hover { border-color: var(--primary); }
  .sub-card__avatar {
    width: 40px; height: 40px; border-radius: 50%;
    background: var(--primary); color: #fff;
    display: inline-flex; align-items: center; justify-content: center;
    font-weight: 700; flex-shrink: 0;
  }
  .sub-card__body { flex: 1; min-width: 0; }
  .sub-card__handle { font-size: 0.9rem; font-weight: 600; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .sub-card__meta { font-size: 0.75rem; color: var(--fg-muted); }
  .sub-card__status {
    font-size: 0.65rem; font-weight: 700; padding: 0.25rem 0.5rem; border-radius: 999px;
    text-transform: uppercase;
  }
  .sub-card__status--active { background: var(--success-soft); color: var(--primary-strong); }
  .sub-card__status--paused { background: var(--warning-soft); color: var(--warning); }
  .sub-card__status--unsubscribed { background: var(--bg-sunken); color: var(--fg-faint); }
  .sub-card__status--blacklisted { background: var(--danger-soft); color: var(--danger); }

  .modal-backdrop {
    position: fixed; inset: 0; background: var(--backdrop); z-index: 40;
  }
  .modal {
    position: fixed; bottom: 0; left: 0; right: 0; z-index: 50;
    background: var(--bg-elev); border-radius: var(--radius-xl) var(--radius-xl) 0 0;
    max-height: 80vh; overflow-y: auto;
    padding: 1.25rem;
    animation: slideUp 0.3s var(--ease-spring);
  }
  @keyframes slideUp {
    from { transform: translateY(100%); }
    to { transform: translateY(0); }
  }
  .modal__head {
    display: flex; align-items: center; justify-content: space-between;
    margin-bottom: 1rem; padding-bottom: 0.75rem; border-bottom: 1px solid var(--border);
  }
  .modal__head h3 { font-size: 1rem; }
  .modal__close {
    width: 36px; height: 36px; border-radius: 8px;
    display: inline-flex; align-items: center; justify-content: center;
    color: var(--fg-muted);
  }
  .modal__row {
    display: flex; justify-content: space-between; padding: 0.625rem 0;
    border-bottom: 1px solid var(--border); font-size: 0.875rem;
  }
  .modal__row:last-child { border-bottom: none; }
  .modal__row-label { color: var(--fg-muted); }
  .modal__actions { display: flex; flex-wrap: wrap; gap: 0.5rem; margin-top: 1rem; }

  @media (min-width: 768px) {
    .filter-bar { flex-direction: row; }
    .filter-bar .select { width: 180px; }
    .modal { left: 50%; right: auto; bottom: auto; top: 50%; transform: translate(-50%, -50%);
      width: 480px; max-width: 90vw; border-radius: var(--radius-xl); }
  }
</style>

<script>
  function escapeHtml(s) {
    return String(s ?? "").replace(/[&<>"']/g, (c) => ({
      "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;", "'": "&#39;",
    }[c]));
  }

  const list = document.getElementById("subs-list");
  const searchInput = document.getElementById("search");
  const platformFilter = document.getElementById("platform-filter");
  const statusFilter = document.getElementById("status-filter");
  const countChip = document.querySelector(".count-chip");
  const pagination = document.getElementById("pagination");
  const loadMoreBtn = document.getElementById("load-more");
  const modalBackdrop = document.getElementById("modal-backdrop");
  const modal = document.getElementById("sub-modal");
  const modalBody = document.getElementById("modal-body");

  let cursor, currentSearch = "", currentPlatform = "", currentStatus = "";

  async function load(reset = true) {
    if (reset) {
      cursor = undefined;
      list.innerHTML = `<div class="card shimmer-card" style="padding:1.5rem"><div class="shimmer" style="height:14px;width:60%;border-radius:4px"></div></div>`;
    }
    const params = new URLSearchParams();
    if (currentSearch) params.set("search", currentSearch);
    if (currentPlatform) params.set("platform", currentPlatform);
    if (currentStatus) params.set("status", currentStatus);
    params.set("limit", "25");
    if (cursor) params.set("after", cursor);
    try {
      const res = await fetch(`/api/admin/subscribers?${params}`);
      const data = await res.json();
      if (!data.ok) throw new Error(data.error);
      if (countChip) countChip.textContent = String(data.count);
      const rows = data.data.map((s) => `
        <div class="card sub-card" data-id="${s.id}">
          <div class="sub-card__avatar">${escapeHtml((s.handle || "?").charAt(0))}</div>
          <div class="sub-card__body">
            <div class="sub-card__handle">${escapeHtml(s.handle)}</div>
            <div class="sub-card__meta">${escapeHtml(s.platform)} · joined ${new Date(s.joinedAt).toLocaleDateString()}</div>
          </div>
          <span class="sub-card__status sub-card__status--${escapeHtml(s.status)}">${escapeHtml(s.status)}</span>
        </div>
      `).join("");
      if (reset) {
        list.innerHTML = data.data.length === 0 ? `<div style="padding:2rem;text-align:center;color:var(--fg-faint)">No subscribers yet.</div>` : rows;
      } else {
        list.insertAdjacentHTML("beforeend", rows);
      }
      pagination.hidden = !data.hasMore;
      if (data.data.length > 0) cursor = data.data[data.data.length - 1].id;
    } catch (e) {
      list.innerHTML = `<div class="card" style="padding:1.5rem;color:var(--danger)">${e.message}</div>`;
    }
  }

  async function showSubscriber(id) {
    modalBody.innerHTML = `<div class="shimmer" style="height:60px;border-radius:8px"></div>`;
    modal.hidden = false;
    modalBackdrop.hidden = false;
    try {
      const res = await fetch(`/api/admin/subscribers?search=&platform=&status=&limit=100`);
      const data = await res.json();
      const sub = data.data.find((s) => s.id === id);
      if (!sub) throw new Error("Not found");
      modalBody.innerHTML = `
        <div class="modal__row"><span class="modal__row-label">Handle</span><span>${escapeHtml(sub.handle)}</span></div>
        <div class="modal__row"><span class="modal__row-label">Platform</span><span>${escapeHtml(sub.platform)}</span></div>
        <div class="modal__row"><span class="modal__row-label">Status</span><span>${escapeHtml(sub.status)}</span></div>
        <div class="modal__row"><span class="modal__row-label">Timezone</span><span>${escapeHtml(sub.timezone)}</span></div>
        <div class="modal__row"><span class="modal__row-label">Language</span><span>${escapeHtml(sub.language)}</span></div>
        <div class="modal__row"><span class="modal__row-label">Joined</span><span>${new Date(sub.joinedAt).toLocaleString()}</span></div>
        <div class="modal__row"><span class="modal__row-label">Last seen</span><span>${sub.lastSeenAt ? new Date(sub.lastSeenAt).toLocaleString() : "—"}</span></div>
        <div class="modal__actions">
          ${sub.status !== "paused" ? `<button class="btn btn-outline btn-sm" data-action="pause" data-id="${sub.id}">Pause</button>` : ""}
          ${sub.status !== "active" ? `<button class="btn btn-primary btn-sm" data-action="activate" data-id="${sub.id}">Activate</button>` : ""}
          ${sub.status !== "blacklisted" ? `<button class="btn btn-danger btn-sm" data-action="blacklist" data-id="${sub.id}">Blacklist</button>` : ""}
        </div>
      `;
      modalBody.querySelectorAll("[data-action]").forEach((btn) => {
        btn.addEventListener("click", async () => {
          const action = btn.dataset.action;
          const id = btn.dataset.id;
          const newStatus = action === "pause" ? "paused" : action === "activate" ? "active" : "blacklisted";
          try {
            const r = await fetch(`/api/admin/subscribers/${id}`, {
              method: "PATCH",
              headers: { "Content-Type": "application/json" },
              body: JSON.stringify({ status: newStatus }),
            });
            if (r.ok) {
              closeModal();
              load(true);
            } else {
              const d = await r.json();
              alert(d.error || "Failed");
            }
          } catch (e) { alert(e.message); }
        });
      });
    } catch (e) {
      modalBody.innerHTML = `<div style="padding:1rem;color:var(--danger)">${e.message}</div>`;
    }
  }

  function closeModal() {
    modal.hidden = true;
    modalBackdrop.hidden = true;
  }

  list?.addEventListener("click", (e) => {
    const card = e.target.closest(".sub-card");
    if (card) showSubscriber(card.dataset.id);
  });
  document.getElementById("close-modal")?.addEventListener("click", closeModal);
  modalBackdrop?.addEventListener("click", closeModal);

  let timer;
  searchInput?.addEventListener("input", () => {
    clearTimeout(timer);
    timer = setTimeout(() => {
      currentSearch = searchInput.value.trim();
      load(true);
    }, 300);
  });
  platformFilter?.addEventListener("change", () => { currentPlatform = platformFilter.value; load(true); });
  statusFilter?.addEventListener("change", () => { currentStatus = statusFilter.value; load(true); });
  loadMoreBtn?.addEventListener("click", () => load(false));
  load(true);
</script>

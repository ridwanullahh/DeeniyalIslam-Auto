---
/**
 * /admin/quran — list Quran verses with search, filter by surah, paginated.
 * Mobile-native: pull-to-search bar at top, list below, FAB to add.
 */
import AdminLayout from "@/layouts/AdminLayout.astro";
import Icon from "@/components/Icon.astro";
---

<AdminLayout title="Quran Verses" activeNav="content">
  <div class="content-list-page">
    <div class="page-head">
      <div class="page-head__left">
        <a href="/admin/quran/new" class="btn btn-primary page-head__cta">
          <Icon name="plus" size={16} />
          New verse
        </a>
      </div>
      <div class="page-head__right">
        <span class="chip chip-primary">
          <Icon name="book" size={12} />
          <span id="count-chip">…</span> verses
        </span>
      </div>
    </div>

    <div class="filter-bar">
      <div class="search-input">
        <Icon name="search" size={16} />
        <input
          type="search"
          id="search-input"
          placeholder="Search by translation, surah name, or Arabic text…"
          autocomplete="off"
        />
      </div>
      <select class="select filter-select" id="surah-filter">
        <option value="">All surahs</option>
      </select>
    </div>

    <div class="list" id="verses-list">
      <div class="skeleton-list">
        {Array.from({ length: 5 }).map(() => (
          <div class="card verse-card shimmer-card">
            <div class="shimmer" style="height:36px;width:36px;border-radius:8px"></div>
            <div class="verse-card__body">
              <div class="shimmer" style="height:12px;width:120px;border-radius:4px;margin-bottom:6px"></div>
              <div class="shimmer" style="height:10px;width:80%;border-radius:4px;margin-bottom:4px"></div>
              <div class="shimmer" style="height:10px;width:60%;border-radius:4px"></div>
            </div>
          </div>
        ))}
      </div>
    </div>

    <div class="pagination" id="pagination" hidden>
      <button class="btn btn-outline" id="load-more">Load more</button>
    </div>
  </div>
</AdminLayout>

<style>
  .content-list-page {
    display: flex;
    flex-direction: column;
    gap: 0.875rem;
  }
  .page-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.625rem;
  }
  .page-head__cta { min-height: 40px; }
  .page-head__right {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
  }

  .filter-bar {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }
  .search-input {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0 0.875rem;
    background: var(--bg-elev);
    border: 1.5px solid var(--border-strong);
    border-radius: var(--radius-md);
    color: var(--fg-faint);
    transition: border 0.15s, color 0.15s;
    min-height: 44px;
  }
  .search-input:focus-within {
    border-color: var(--primary);
    color: var(--primary-strong);
  }
  .search-input input {
    flex: 1;
    border: none;
    outline: none;
    background: transparent;
    color: var(--fg);
    font-size: 0.95rem;
  }
  .filter-select {
    min-height: 44px;
  }

  .list {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .verse-card {
    padding: 0.875rem 1rem;
    display: flex;
    align-items: flex-start;
    gap: 0.75rem;
    transition: border 0.15s, transform 0.15s;
    text-decoration: none;
    color: inherit;
  }
  .verse-card:hover {
    border-color: var(--primary);
    text-decoration: none;
  }
  .verse-card:active {
    transform: scale(0.99);
  }
  .verse-card__ref {
    width: 44px;
    height: 44px;
    border-radius: 10px;
    background: var(--success-soft);
    color: var(--primary-strong);
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    font-weight: 700;
    font-size: 0.85rem;
    line-height: 1;
    gap: 0.1rem;
  }
  .verse-card__ref small {
    font-size: 0.55rem;
    font-weight: 600;
    opacity: 0.7;
    text-transform: uppercase;
  }
  .verse-card__body {
    flex: 1;
    min-width: 0;
  }
  .verse-card__name {
    font-size: 0.85rem;
    font-weight: 600;
    margin-bottom: 0.25rem;
    color: var(--fg-muted);
  }
  .verse-card__arabic {
    font-family: var(--font-arabic);
    font-size: 1.15rem;
    color: var(--fg);
    direction: rtl;
    margin-bottom: 0.25rem;
    line-height: 1.6;
    overflow: hidden;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
  }
  .verse-card__translation {
    font-size: 0.85rem;
    color: var(--fg-muted);
    overflow: hidden;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
  }
  .verse-card__tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem;
    margin-top: 0.5rem;
  }
  .verse-card__tags .chip {
    font-size: 0.65rem;
    padding: 0.125rem 0.5rem;
  }
  .verse-card__actions {
    align-self: center;
    color: var(--fg-faint);
    flex-shrink: 0;
  }

  .empty-state {
    padding: 3rem 1rem;
    text-align: center;
    color: var(--fg-faint);
  }
  .empty-state__title {
    font-size: 1rem;
    font-weight: 600;
    color: var(--fg);
    margin-bottom: 0.25rem;
  }

  .pagination {
    display: flex;
    justify-content: center;
    padding: 1rem 0;
  }

  @media (min-width: 768px) {
    .filter-bar {
      flex-direction: row;
    }
    .filter-select {
      width: 200px;
    }
  }
</style>

<script>
  let cursor: string | undefined = undefined;
  let hasMore = false;
  let totalCount = 0;
  let currentSearch = "";
  let currentSurah = "";

  const list = document.getElementById("verses-list")!;
  const searchInput = document.getElementById("search-input") as HTMLInputElement;
  const surahFilter = document.getElementById("surah-filter") as HTMLSelectElement;
  const countChip = document.getElementById("count-chip");
  const pagination = document.getElementById("pagination")!;
  const loadMoreBtn = document.getElementById("load-more") as HTMLButtonElement;

  async function loadVerses(reset = true) {
    if (reset) {
      cursor = undefined;
      list.innerHTML = `<div class="card shimmer-card" style="padding:1.5rem"><div class="shimmer" style="height:14px;width:60%;border-radius:4px"></div></div>`;
    }
    const params = new URLSearchParams();
    if (currentSearch) params.set("search", currentSearch);
    if (currentSurah) params.set("surah", currentSurah);
    params.set("limit", "25");
    if (cursor) params.set("after", cursor);

    try {
      const res = await fetch(`/api/admin/quran?${params}`, { headers: { Accept: "application/json" } });
      if (!res.ok) throw new Error(`HTTP ${res.status}`);
      const data = await res.json();
      if (!data.ok) throw new Error(data.error || "Failed");

      hasMore = data.hasMore;
      totalCount = data.count;
      if (countChip) countChip.textContent = String(totalCount);

      const rows = data.data.map((v: any) => `
        <a href="/admin/quran/${v.id}" class="card verse-card fade-in">
          <div class="verse-card__ref">
            <small>Surah</small>
            ${v.surah}:${v.ayah}
          </div>
          <div class="verse-card__body">
            <div class="verse-card__name">${v.surahNameEn} · ${v.surahNameAr}</div>
            <div class="verse-card__arabic" dir="rtl" lang="ar">${v.arabic}</div>
            <div class="verse-card__translation">${v.translation}</div>
            ${(v.tags && v.tags.length > 0) ? `<div class="verse-card__tags">${v.tags.slice(0, 4).map((t: string) => `<span class="chip">${t}</span>`).join("")}</div>` : ""}
          </div>
          <div class="verse-card__actions">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M9 6l6 6-6 6"/></svg>
          </div>
        </a>
      `).join("");

      if (reset) {
        if (data.data.length === 0) {
          list.innerHTML = `<div class="empty-state">
            <div class="empty-state__title">No verses found</div>
            <div>Try a different search, or <a href="/admin/quran/new" style="color:var(--primary-strong);font-weight:600">add a new verse</a>.</div>
          </div>`;
        } else {
          list.innerHTML = rows;
        }
      } else {
        list.insertAdjacentHTML("beforeend", rows);
      }

      pagination.hidden = !hasMore;
      if (data.data.length > 0) cursor = data.data[data.data.length - 1].id;
    } catch (e) {
      list.innerHTML = `<div class="card" style="padding:1.5rem;color:var(--danger)">${e instanceof Error ? e.message : "Failed to load"}</div>`;
    }
  }

  // Debounced search
  let searchTimer: ReturnType<typeof setTimeout>;
  searchInput?.addEventListener("input", () => {
    clearTimeout(searchTimer);
    searchTimer = setTimeout(() => {
      currentSearch = searchInput.value.trim();
      loadVerses(true);
    }, 300);
  });

  surahFilter?.addEventListener("change", () => {
    currentSurah = surahFilter.value;
    loadVerses(true);
  });

  loadMoreBtn?.addEventListener("click", () => loadVerses(false));

  // Populate surah filter
  const surahs = [
    [1, "Al-Fatihah"], [2, "Al-Baqarah"], [3, "Aal-E-Imran"], [4, "An-Nisa"], [5, "Al-Maidah"],
    [112, "Al-Ikhlas"], [113, "Al-Falaq"], [114, "An-Nas"], [108, "Al-Kawthar"], [103, "Al-Asr"],
    [105, "Al-Fil"], [106, "Quraysh"], [107, "Al-Maun"], [16, "An-Nahl"], [39, "Az-Zumar"],
  ];
  surahFilter.innerHTML = "<option value=\"\">All surahs</option>" +
    surahs.map(([n, name]) => `<option value="${n}">${n}. ${name}</option>`).join("");

  loadVerses(true);
</script>

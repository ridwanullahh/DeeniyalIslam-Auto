---
/**
 * /admin/quran/new — create a new Quran verse.
 * /admin/quran/[id] — edit an existing verse.
 *
 * Mobile-native form with Arabic-friendly inputs.
 */
import AdminLayout from "@/layouts/AdminLayout.astro";
import Icon from "@/components/Icon.astro";
import { collections } from "@/lib/lightbase/client";

const id = Astro.params.id;
const isEdit = !!id && id !== "new";

let verse: any = null;
if (isEdit && id) {
  try {
    verse = await collections("quran_verses").get(id);
    if (!verse) {
      return Astro.redirect("/admin/quran", 302);
    }
  } catch (e) {
    return Astro.redirect("/admin/quran", 302);
  }
}
---

<AdminLayout title={isEdit ? "Edit Verse" : "New Verse"} activeNav="content">
  <div class="form-page">
    <a href="/admin/quran" class="back-link">
      <Icon name="arrow_left" size={14} />
      Back to Quran
    </a>

    <form id="verse-form" class="form card">
      <input type="hidden" name="id" value={id ?? ""} />

      <div class="form-row form-row--2">
        <label class="field">
          <span class="field__label">Surah number</span>
          <input type="number" name="surah" min="1" max="114" required
            value={verse?.surah ?? ""} class="input" placeholder="1" />
        </label>
        <label class="field">
          <span class="field__label">Ayah number</span>
          <input type="number" name="ayah" min="1" required
            value={verse?.ayah ?? ""} class="input" placeholder="1" />
        </label>
      </div>

      <div class="form-row form-row--2">
        <label class="field">
          <span class="field__label">Surah name (Arabic)</span>
          <input type="text" name="surahNameAr" required
            value={verse?.surahNameAr ?? ""} class="input font-arabic" dir="rtl" lang="ar"
            placeholder="الفاتحة" />
        </label>
        <label class="field">
          <span class="field__label">Surah name (English)</span>
          <input type="text" name="surahNameEn" required
            value={verse?.surahNameEn ?? ""} class="input"
            placeholder="The Opening" />
        </label>
      </div>

      <label class="field">
        <span class="field__label">Surah name (transliteration)</span>
        <input type="text" name="surahNameTranslit"
          value={verse?.surahNameTranslit ?? ""} class="input"
          placeholder="Al-Fatihah" />
      </label>

      <label class="field">
        <span class="field__label">Arabic text</span>
        <textarea name="arabic" required rows="3" class="textarea font-arabic" dir="rtl" lang="ar"
          placeholder="بِسْمِ اللَّهِ الرَّحْمَٰنِ الرَّحِيمِ">{verse?.arabic ?? ""}</textarea>
      </label>

      <label class="field">
        <span class="field__label">Translation</span>
        <textarea name="translation" required rows="3" class="textarea"
          placeholder="In the name of Allah, the Most Merciful, the Especially Merciful.">{verse?.translation ?? ""}</textarea>
      </label>

      <label class="field">
        <span class="field__label">Transliteration</span>
        <textarea name="transliteration" rows="2" class="textarea"
          placeholder="Bismillaahir-Rahmaanir-Raheem">{verse?.transliteration ?? ""}</textarea>
      </label>

      <div class="form-row form-row--2">
        <label class="field">
          <span class="field__label">Source</span>
          <input type="text" name="source"
            value={verse?.source ?? "Saheeh International"} class="input" />
        </label>
        <label class="field">
          <span class="field__label">Tags (comma-separated)</span>
          <input type="text" name="tags"
            value={(verse?.tags ?? []).join(", ")} class="input"
            placeholder="basmalah, foundation" />
        </label>
      </div>

      <div class="form-row form-row--2">
        <label class="field">
          <span class="field__label">Juz (optional)</span>
          <input type="number" name="juz" min="1" max="30"
            value={verse?.juz ?? ""} class="input" placeholder="1" />
        </label>
        <label class="field">
          <span class="field__label">Mushaf page (optional)</span>
          <input type="number" name="page" min="1" max="604"
            value={verse?.page ?? ""} class="input" placeholder="1" />
        </label>
      </div>

      <div id="form-error" class="form-error" hidden></div>

      <div class="form-actions">
        {isEdit && (
          <button type="button" class="btn btn-danger" id="delete-btn">
            <Icon name="trash" size={16} />
            Delete
          </button>
        )}
        <button type="submit" class="btn btn-primary" id="submit-btn">
          <Icon name="check" size={16} />
          {isEdit ? "Save changes" : "Create verse"}
        </button>
      </div>
    </form>
  </div>
</AdminLayout>

<style>
  .form-page {
    max-width: 760px;
    margin: 0 auto;
  }
  .back-link {
    display: inline-flex;
    align-items: center;
    gap: 0.25rem;
    color: var(--fg-muted);
    font-size: 0.875rem;
    text-decoration: none;
    margin-bottom: 0.875rem;
  }
  .back-link:hover { color: var(--primary-strong); }

  .form {
    padding: 1.25rem;
    display: flex;
    flex-direction: column;
    gap: 0.875rem;
  }

  .field {
    display: flex;
    flex-direction: column;
    gap: 0.375rem;
  }
  .field__label {
    font-size: 0.8rem;
    font-weight: 600;
    color: var(--fg-muted);
  }

  .form-row {
    display: flex;
    flex-direction: column;
    gap: 0.875rem;
  }

  .form-error {
    background: var(--danger-soft);
    color: var(--danger);
    padding: 0.75rem 1rem;
    border-radius: var(--radius-md);
    font-size: 0.875rem;
    border: 1px solid color-mix(in srgb, var(--danger) 30%, transparent);
  }

  .form-actions {
    display: flex;
    justify-content: space-between;
    gap: 0.625rem;
    padding-top: 0.5rem;
    border-top: 1px solid var(--border);
  }

  @media (min-width: 768px) {
    .form-row--2 {
      flex-direction: row;
    }
    .form-row--2 > * {
      flex: 1;
    }
  }
</style>

<script define:vars={{ isEdit, id }}>
  const form = document.getElementById("verse-form");
  const errorBox = document.getElementById("form-error");
  const submitBtn = document.getElementById("submit-btn");
  const deleteBtn = document.getElementById("delete-btn");

  async function submitForm(e) {
    e.preventDefault();
    if (errorBox) errorBox.hidden = true;
    if (submitBtn) submitBtn.disabled = true;

    const fd = new FormData(form);
    const body = {
      surah: Number(fd.get("surah")),
      ayah: Number(fd.get("ayah")),
      surahNameAr: fd.get("surahNameAr"),
      surahNameEn: fd.get("surahNameEn"),
      surahNameTranslit: fd.get("surahNameTranslit") || "",
      arabic: fd.get("arabic"),
      translation: fd.get("translation"),
      transliteration: fd.get("transliteration") || "",
      source: fd.get("source") || "Saheeh International",
      tags: (fd.get("tags") || "").split(",").map(s => s.trim()).filter(Boolean),
      juz: fd.get("juz") ? Number(fd.get("juz")) : undefined,
      page: fd.get("page") ? Number(fd.get("page")) : undefined,
    };
    if (body.juz === undefined) delete body.juz;
    if (body.page === undefined) delete body.page;

    try {
      const url = isEdit ? `/api/admin/quran/${id}` : "/api/admin/quran";
      const method = isEdit ? "PATCH" : "POST";
      const res = await fetch(url, {
        method,
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify(body),
      });
      const data = await res.json();
      if (!res.ok || !data.ok) throw new Error(data.error || `Failed: ${res.status}`);
      window.location.href = "/admin/quran";
    } catch (err) {
      if (errorBox) {
        errorBox.textContent = err.message || "Failed to save";
        errorBox.hidden = false;
      }
      if (submitBtn) submitBtn.disabled = false;
    }
  }

  async function deleteVerse() {
    if (!isEdit || !id) return;
    if (!confirm("Are you sure you want to delete this verse? This cannot be undone.")) return;
    try {
      const res = await fetch(`/api/admin/quran/${id}`, { method: "DELETE" });
      if (!res.ok) {
        const data = await res.json();
        throw new Error(data.error || `Failed: ${res.status}`);
      }
      window.location.href = "/admin/quran";
    } catch (err) {
      if (errorBox) {
        errorBox.textContent = err.message || "Failed to delete";
        errorBox.hidden = false;
      }
    }
  }

  form?.addEventListener("submit", submitForm);
  deleteBtn?.addEventListener("click", deleteVerse);
</script>

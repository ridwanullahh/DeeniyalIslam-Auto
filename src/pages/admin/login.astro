---
/**
 * /admin/login — mobile-native admin login page.
 * Bare layout (no topbar, no bottom nav) — single-purpose screen.
 */
import BaseLayout from "@/layouts/BaseLayout.astro";
import Icon from "@/components/Icon.astro";
import { CONFIG } from "@/config";

// If already logged in, redirect to /admin
import { readSessionFromRequest } from "@/lib/auth/session";
const session = await readSessionFromRequest(Astro.request);
if (session) {
  return Astro.redirect("/admin", 302);
}
---

<BaseLayout title="Admin Login" bare bodyClass="login-page">
  <div class="login-screen">
    <div class="login-hero fade-in">
      <div class="login-logo" aria-hidden="true">
        <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
          <path d="M3 21h18M5 21V11l7-5 7 5v10M9 21v-5h6v5M12 6V3" />
        </svg>
      </div>
      <h1 class="login-title">Admin Access</h1>
      <p class="login-sub">Sign in to manage content, subscribers, and posts.</p>
    </div>

    <form id="login-form" class="login-form fade-in" style="animation-delay: 0.05s">
      <label class="field">
        <span class="field__label">Email</span>
        <input
          type="email"
          name="email"
          autocomplete="username"
          required
          placeholder="admin@deeniyalislam.auto"
          class="input"
          autocapitalize="none"
          spellcheck="false"
        />
      </label>

      <label class="field">
        <span class="field__label">Password</span>
        <div class="password-field">
          <input
            type="password"
            name="password"
            autocomplete="current-password"
            required
            class="input"
            id="password-input"
            placeholder="Enter your password"
          />
          <button
            type="button"
            class="password-toggle"
            aria-label="Show password"
            data-password-toggle
          >
            <svg class="eye-open" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M2 12s4-7 10-7 10 7 10 7-4 7-10 7S2 12 2 12ZM12 9a3 3 0 1 0 0 6 3 3 0 0 0 0-6Z"/></svg>
            <svg class="eye-closed" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M3 3l18 18M10.6 10.6a3 3 0 0 0 4.2 4.2M9.4 5.2A10 10 0 0 1 22 12s-1 1.7-2.8 3.4M6.6 6.6A10 10 0 0 0 2 12s4 7 10 7a10 10 0 0 0 4.2-.9"/></svg>
          </button>
        </div>
      </label>

      <div id="login-error" class="login-error" hidden></div>

      <button type="submit" class="btn btn-primary login-submit" id="login-submit">
        <span class="login-submit__label">Sign in</span>
        <span class="login-submit__spinner" hidden>
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
            <path d="M21 12a9 9 0 1 1-6.219-8.56" />
          </svg>
        </span>
      </button>

      <a href="/" class="login-back">
        <Icon name="arrow_left" size={14} />
        Back to site
      </a>
    </form>
  </div>
</BaseLayout>

<style>
  .login-screen {
    flex: 1;
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding: 2rem 1.5rem;
    min-height: 100dvh;
    background:
      radial-gradient(circle at 0% 0%, color-mix(in srgb, var(--primary) 12%, transparent) 0%, transparent 50%),
      radial-gradient(circle at 100% 100%, color-mix(in srgb, var(--accent) 10%, transparent) 0%, transparent 50%),
      var(--bg);
  }

  .login-hero {
    text-align: center;
    margin-bottom: 2rem;
  }

  .login-logo {
    width: 64px;
    height: 64px;
    border-radius: 18px;
    background: linear-gradient(135deg, var(--primary) 0%, var(--primary-strong) 100%);
    color: #fff;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    margin-bottom: 1rem;
    box-shadow: 0 8px 24px color-mix(in srgb, var(--primary) 35%, transparent);
  }

  .login-title {
    font-size: 1.75rem;
    line-height: 1.1;
    margin-bottom: 0.375rem;
    letter-spacing: -0.02em;
  }

  .login-sub {
    color: var(--fg-muted);
    font-size: 0.95rem;
  }

  .login-form {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    width: 100%;
    max-width: 380px;
    margin: 0 auto;
  }

  .field {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .field__label {
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--fg-muted);
  }

  .password-field {
    position: relative;
  }

  .password-field .input {
    padding-right: 2.75rem;
  }

  .password-toggle {
    position: absolute;
    right: 0.5rem;
    top: 50%;
    transform: translateY(-50%);
    width: 36px;
    height: 36px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    color: var(--fg-faint);
    border-radius: 8px;
    transition: color 0.15s, background 0.15s;
  }
  .password-toggle:hover {
    color: var(--fg);
    background: var(--bg-sunken);
  }
  .password-toggle .eye-closed { display: none; }
  .password-toggle.is-visible .eye-open { display: none; }
  .password-toggle.is-visible .eye-closed { display: inline-flex; }

  .login-error {
    background: var(--danger-soft);
    color: var(--danger);
    padding: 0.75rem 1rem;
    border-radius: var(--radius-md);
    font-size: 0.875rem;
    border: 1px solid color-mix(in srgb, var(--danger) 30%, transparent);
    animation: shake 0.4s;
  }
  @keyframes shake {
    0%, 100% { transform: translateX(0); }
    20%, 60% { transform: translateX(-4px); }
    40%, 80% { transform: translateX(4px); }
  }

  .login-submit {
    width: 100%;
    height: 52px;
    margin-top: 0.5rem;
    font-size: 1rem;
    position: relative;
  }
  .login-submit:disabled {
    opacity: 0.7;
  }
  .login-submit__spinner {
    position: absolute;
    right: 1rem;
    top: 50%;
    transform: translateY(-50%);
  }
  .login-submit__spinner svg {
    animation: spin 0.8s linear infinite;
  }
  @keyframes spin {
    to { transform: rotate(360deg); }
  }

  .login-back {
    text-align: center;
    color: var(--fg-muted);
    font-size: 0.875rem;
    margin-top: 0.5rem;
    display: inline-flex;
    align-items: center;
    gap: 0.25rem;
    justify-content: center;
    text-decoration: none;
  }
  .login-back:hover {
    color: var(--primary-strong);
  }
</style>

<script>
  // Password visibility toggle
  const toggle = document.querySelector("[data-password-toggle]");
  const passwordInput = document.getElementById("password-input") as HTMLInputElement | null;
  toggle?.addEventListener("click", () => {
    if (!passwordInput) return;
    const isHidden = passwordInput.type === "password";
    passwordInput.type = isHidden ? "text" : "password";
    toggle.classList.toggle("is-visible", isHidden);
    toggle.setAttribute("aria-label", isHidden ? "Hide password" : "Show password");
  });

  // Form submission
  const form = document.getElementById("login-form") as HTMLFormElement | null;
  const errorBox = document.getElementById("login-error");
  const submitBtn = document.getElementById("login-submit") as HTMLButtonElement | null;
  const submitLabel = document.querySelector(".login-submit__label");
  const submitSpinner = document.querySelector(".login-submit__spinner") as HTMLElement | null;

  form?.addEventListener("submit", async (e) => {
    e.preventDefault();
    if (!submitBtn || !submitLabel || !submitSpinner) return;
    const fd = new FormData(form);
    const email = (fd.get("email") as string)?.trim().toLowerCase();
    const password = fd.get("password") as string;

    if (errorBox) errorBox.hidden = true;
    submitBtn.disabled = true;
    submitLabel.textContent = "Signing in…";
    submitSpinner.hidden = false;

    try {
      const res = await fetch("/api/admin/login", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({ email, password }),
      });
      const data = await res.json();
      if (res.ok && data.ok) {
        submitLabel.textContent = "Redirecting…";
        window.location.href = "/admin";
        return;
      }
      throw new Error(data?.error || "Login failed");
    } catch (err) {
      if (errorBox) {
        errorBox.textContent = err instanceof Error ? err.message : "Login failed";
        errorBox.hidden = false;
      }
      submitBtn.disabled = false;
      submitLabel.textContent = "Sign in";
      submitSpinner.hidden = true;
    }
  });
</script>

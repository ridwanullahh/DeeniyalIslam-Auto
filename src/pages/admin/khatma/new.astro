---
/**
 * /admin/khatma/new — admin-initiated khatma creation.
 * Lets the admin pick a subscriber + configure pace + schedule.
 */
import AdminLayout from "@/layouts/AdminLayout.astro";
import Icon from "@/components/Icon.astro";
import { collections } from "@/lib/lightbase/client";

// Fetch subscribers for the dropdown
const subsList = await collections("subscribers").list({ limit: 100, sort: "joinedAt:desc" });
const subscribers = subsList.data;
---

<AdminLayout title="New Khatma" activeNav="subscribers">
  <div class="form-page">
    <a href="/admin/khatma" class="back-link">
      <Icon name="arrow_left" size={14} />
      Back to Khatma plans
    </a>

    <form id="khatma-form" class="form card">
      <label class="field">
        <span class="field__label">Subscriber</span>
        <select name="subscriberId" required class="select">
          <option value="">Select a subscriber…</option>
          {subscribers.map((s: any) => (
            <option value={s.id}>{s.handle} ({s.platform}) — {s.timezone}</option>
          ))}
        </select>
      </label>

      <label class="field">
        <span class="field__label">Plan name (optional)</span>
        <input type="text" name="name" class="input" placeholder="Ramadan Khatma" />
      </label>

      <label class="field">
        <span class="field__label">Pace</span>
        <select name="pace" required class="select" id="pace-select">
          <option value="pages_per_day">Pages per day (fixed time)</option>
          <option value="pages_per_salah">Pages after every salah (5x/day)</option>
          <option value="pages_per_week">Pages per week (slow)</option>
          <option value="juz_per_week">1 juz per week (20 pages)</option>
          <option value="complete_in_days">Complete in N days</option>
        </select>
      </label>

      <div class="form-row form-row--2">
        <label class="field" id="pages-per-step-field">
          <span class="field__label">Pages per step</span>
          <input type="number" name="pagesPerStep" class="input" min="1" max="604" value="1" />
        </label>
        <label class="field" id="target-days-field" hidden>
          <span class="field__label">Target days</span>
          <input type="number" name="targetDays" class="input" min="1" max="365" placeholder="30" />
        </label>
      </div>

      <label class="field">
        <span class="field__label">Schedule type</span>
        <select name="scheduleType" required class="select" id="schedule-type-select">
          <option value="salah_relative">Salah-anchored (recommended)</option>
          <option value="cron">Cron (fixed UTC time)</option>
          <option value="interval_minutes">Interval (every N minutes)</option>
        </select>
      </label>

      <div id="salah-fields">
        <div class="form-row form-row--2">
          <label class="field">
            <span class="field__label">Salah (leave empty = every salah)</span>
            <select name="salahKey" class="select">
              <option value="">Every salah</option>
              <option value="fajr">Fajr</option>
              <option value="dhuhr">Dhuhr</option>
              <option value="asr">Asr</option>
              <option value="maghrib">Maghrib</option>
              <option value="isha">Isha</option>
            </select>
          </label>
          <label class="field">
            <span class="field__label">Offset minutes (after salah)</span>
            <input type="number" name="salahOffsetMinutes" class="input" min="-180" max="180" value="10" />
          </label>
        </div>
      </div>

      <div id="cron-fields" hidden>
        <label class="field">
          <span class="field__label">Cron expression (UTC)</span>
          <input type="text" name="scheduleCron" class="input" placeholder="0 7 * * *" />
        </label>
      </div>

      <div id="interval-fields" hidden>
        <label class="field">
          <span class="field__label">Interval (minutes)</span>
          <input type="number" name="intervalMinutes" class="input" min="30" max="1440" value="360" />
        </label>
      </div>

      <div class="form-row form-row--2">
        <label class="field">
          <span class="field__label">Start page</span>
          <input type="number" name="startPage" class="input" min="1" max="604" value="1" />
        </label>
        <label class="field">
          <span class="field__label">End page</span>
          <input type="number" name="endPage" class="input" min="1" max="604" value="604" />
        </label>
      </div>

      <label class="field">
        <span class="field__label">Channel</span>
        <select name="channel" required class="select">
          <option value="whatsapp">WhatsApp</option>
          <option value="telegram">Telegram</option>
          <option value="discord">Discord</option>
          <option value="messenger">Messenger</option>
        </select>
      </label>

      <div id="form-error" class="form-error" hidden></div>

      <div class="form-actions">
        <button type="submit" class="btn btn-primary" id="submit-btn">
          <Icon name="check" size={16} />
          Create khatma
        </button>
      </div>
    </form>
  </div>
</AdminLayout>

<style>
  .form-page { max-width: 760px; margin: 0 auto; }
  .back-link {
    display: inline-flex; align-items: center; gap: 0.25rem;
    color: var(--fg-muted); font-size: 0.875rem; text-decoration: none; margin-bottom: 0.875rem;
  }
  .back-link:hover { color: var(--primary-strong); }
  .form { padding: 1.25rem; display: flex; flex-direction: column; gap: 0.875rem; }
  .field { display: flex; flex-direction: column; gap: 0.375rem; }
  .field__label { font-size: 0.8rem; font-weight: 600; color: var(--fg-muted); }
  .form-row { display: flex; flex-direction: column; gap: 0.875rem; }
  .form-error {
    background: var(--danger-soft); color: var(--danger); padding: 0.75rem 1rem;
    border-radius: var(--radius-md); font-size: 0.875rem;
    border: 1px solid color-mix(in srgb, var(--danger) 30%, transparent);
  }
  .form-actions { display: flex; justify-content: flex-end; padding-top: 0.5rem; border-top: 1px solid var(--border); }
  @media (min-width: 768px) {
    .form-row--2 { flex-direction: row; }
    .form-row--2 > * { flex: 1; }
  }
</style>

<script>
  const paceSelect = document.getElementById("pace-select");
  const pagesPerStepField = document.getElementById("pages-per-step-field");
  const targetDaysField = document.getElementById("target-days-field");
  const scheduleTypeSelect = document.getElementById("schedule-type-select");
  const salahFields = document.getElementById("salah-fields");
  const cronFields = document.getElementById("cron-fields");
  const intervalFields = document.getElementById("interval-fields");

  function updatePaceFields() {
    const pace = paceSelect.value;
    pagesPerStepField.hidden = pace === "complete_in_days" || pace === "juz_per_week";
    targetDaysField.hidden = pace !== "complete_in_days";
  }
  function updateScheduleFields() {
    const t = scheduleTypeSelect.value;
    salahFields.hidden = t !== "salah_relative";
    cronFields.hidden = t !== "cron";
    intervalFields.hidden = t !== "interval_minutes";
  }
  paceSelect.addEventListener("change", updatePaceFields);
  scheduleTypeSelect.addEventListener("change", updateScheduleFields);
  updatePaceFields();
  updateScheduleFields();

  const form = document.getElementById("khatma-form");
  const errorBox = document.getElementById("form-error");
  const submitBtn = document.getElementById("submit-btn");

  form?.addEventListener("submit", async (e) => {
    e.preventDefault();
    if (errorBox) errorBox.hidden = true;
    if (submitBtn) submitBtn.disabled = true;
    const fd = new FormData(form);
    const body = {
      subscriberId: fd.get("subscriberId"),
      name: fd.get("name") || undefined,
      pace: fd.get("pace"),
      pagesPerStep: fd.get("pagesPerStep") ? Number(fd.get("pagesPerStep")) : undefined,
      targetDays: fd.get("targetDays") ? Number(fd.get("targetDays")) : undefined,
      scheduleType: fd.get("scheduleType"),
      scheduleCron: fd.get("scheduleCron") || undefined,
      salahKey: fd.get("salahKey") || undefined,
      salahOffsetMinutes: fd.get("salahOffsetMinutes") ? Number(fd.get("salahOffsetMinutes")) : undefined,
      intervalMinutes: fd.get("intervalMinutes") ? Number(fd.get("intervalMinutes")) : undefined,
      channel: fd.get("channel"),
      startPage: Number(fd.get("startPage")),
      endPage: Number(fd.get("endPage")),
    };
    try {
      const res = await fetch("/api/admin/khatma", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify(body),
      });
      const data = await res.json();
      if (!res.ok || !data.ok) throw new Error(data.error || `Failed: ${res.status}`);
      window.location.href = "/admin/khatma";
    } catch (err) {
      if (errorBox) { errorBox.textContent = err.message; errorBox.hidden = false; }
      if (submitBtn) submitBtn.disabled = false;
    }
  });
</script>

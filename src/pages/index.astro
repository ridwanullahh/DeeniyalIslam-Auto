---
/**
 * Public home — daily verse, daily hadith, daily dhikr, quick subscribe CTA.
 * Mobile-native, brand-styled, light/dark aware.
 */
import BaseLayout from "@/layouts/BaseLayout.astro";
import Icon from "@/components/Icon.astro";
---

<BaseLayout title="DeeniyalIslam Auto" activeNav="home">
  <section class="hero fade-in">
    <div class="hero__eyebrow">
      <Icon name="sparkles" size={14} />
      <span>Bismillah — daily remembrance, delivered</span>
    </div>
    <h1 class="hero__title">Daily remembrance of Allah, delivered.</h1>
    <p class="hero__lede">
      Qur'an verses, authentic Hadith, morning and evening Adhkar — sent to your
      WhatsApp, Telegram, Discord, or Messenger inbox on a schedule that fits
      your day, in your timezone. No noise, no distraction, just Barakah.
    </p>
    <div class="hero__actions">
      <a href="/subscribe" class="btn btn-primary">
        <Icon name="bell" size={18} />
        Subscribe now
      </a>
      <a href="/quran" class="btn btn-outline">
        <Icon name="book" size={18} />
        Read the Qur'an
      </a>
    </div>
  </section>

  <section class="daily-section" id="daily-verse">
    <header class="daily-section__head">
      <span class="chip chip-primary">
        <Icon name="book" size={12} />
        Verse of the moment
      </span>
      <button class="refresh-btn" id="refresh-verse" aria-label="New verse">
        <Icon name="refresh" size={14} />
      </button>
    </header>
    <article class="card daily-card daily-card--verse" id="verse-card">
      <div class="shimmer" style="height:60px;border-radius:8px"></div>
    </article>
  </section>

  <section class="daily-section" id="daily-hadith">
    <header class="daily-section__head">
      <span class="chip chip-accent">
        <Icon name="users" size={12} />
        Hadith of the moment
      </span>
      <button class="refresh-btn" id="refresh-hadith" aria-label="New hadith">
        <Icon name="refresh" size={14} />
      </button>
    </header>
    <article class="card daily-card daily-card--hadith" id="hadith-card">
      <div class="shimmer" style="height:60px;border-radius:8px"></div>
    </article>
  </section>

  <section class="daily-section" id="daily-dhikr">
    <header class="daily-section__head">
      <span class="chip chip-primary">
        <Icon name="bell" size={12} />
        Dhikr of the moment
      </span>
      <button class="refresh-btn" id="refresh-dhikr" aria-label="New dhikr">
        <Icon name="refresh" size={14} />
      </button>
    </header>
    <article class="card daily-card daily-card--dhikr" id="dhikr-card">
      <div class="shimmer" style="height:60px;border-radius:8px"></div>
    </article>
  </section>

  <section class="cta-section fade-in">
    <div class="card cta-card">
      <div class="cta-card__icon">
        <Icon name="bell" size={28} />
      </div>
      <h2>Get reminders in your inbox</h2>
      <p>
        Choose what you want to receive, your channel (WhatsApp, Telegram, Discord,
        Messenger), and your timezone. We'll deliver Barakah to you every day.
      </p>
      <a href="/subscribe" class="btn btn-primary">
        <Icon name="arrow_right" size={16} />
        Set up my reminders
      </a>
    </div>
  </section>

  <section class="bismillah-strip fade-in">
    <p class="bismillah-strip__arabic" dir="rtl" lang="ar">
      فَاذْكُرُونِي أَذْكُرْكُمْ وَاشْكُرُوا لِي وَلَا تَكْفُرُونِ
    </p>
    <p class="bismillah-strip__translation">
      "So remember Me; I will remember you. And be grateful to Me and do not deny Me." — Qur'an 2:152
    </p>
  </section>
</BaseLayout>

<style>
  .hero {
    padding: 2rem 0 1.5rem;
    text-align: center;
  }
  .hero__eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.375rem 0.75rem;
    border-radius: 999px;
    background: var(--accent-soft);
    color: var(--accent-strong);
    border: 1px solid var(--accent);
    font-size: 0.8rem;
    font-weight: 600;
    margin-bottom: 1rem;
  }
  .hero__title {
    font-size: clamp(1.85rem, 7vw, 3rem);
    line-height: 1.05;
    letter-spacing: -0.03em;
    margin-bottom: 0.875rem;
    background: linear-gradient(135deg, var(--fg) 0%, var(--primary-strong) 100%);
    -webkit-background-clip: text;
    background-clip: text;
    -webkit-text-fill-color: transparent;
  }
  .hero__lede {
    font-size: 0.95rem;
    color: var(--fg-muted);
    max-width: 32rem;
    margin: 0 auto 1.5rem;
    line-height: 1.55;
  }
  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    justify-content: center;
  }

  .daily-section {
    margin: 1.25rem 0;
  }
  .daily-section__head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 0.625rem;
  }
  .refresh-btn {
    width: 32px;
    height: 32px;
    border-radius: 50%;
    background: var(--bg-elev);
    border: 1px solid var(--border);
    color: var(--fg-muted);
    display: inline-flex;
    align-items: center;
    justify-content: center;
    transition: color 0.15s, border-color 0.15s, transform 0.4s var(--ease-spring);
  }
  .refresh-btn:hover {
    color: var(--primary-strong);
    border-color: var(--primary);
  }
  .refresh-btn.spinning svg {
    animation: spin 0.6s linear;
  }
  @keyframes spin {
    to { transform: rotate(360deg); }
  }

  .daily-card {
    padding: 1.25rem;
  }
  .daily-card__ref {
    font-size: 0.75rem;
    color: var(--primary-strong);
    font-weight: 700;
    margin-bottom: 0.625rem;
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }
  .daily-card__arabic {
    font-family: var(--font-arabic);
    font-size: 1.5rem;
    line-height: 1.9;
    color: var(--fg);
    direction: rtl;
    text-align: right;
    margin-bottom: 0.75rem;
  }
  .daily-card__translation {
    font-size: 0.95rem;
    color: var(--fg);
    line-height: 1.6;
    margin-bottom: 0.625rem;
  }
  .daily-card__source {
    font-size: 0.75rem;
    color: var(--fg-faint);
    font-style: italic;
  }
  .daily-card__narrator {
    font-size: 0.8rem;
    color: var(--primary-strong);
    font-weight: 600;
    margin-bottom: 0.5rem;
  }

  .cta-section {
    margin: 2rem 0 1rem;
  }
  .cta-card {
    padding: 1.75rem 1.25rem;
    text-align: center;
    background: linear-gradient(135deg, var(--success-soft) 0%, var(--accent-soft) 100%);
    border: 1px solid var(--border-strong);
  }
  .cta-card__icon {
    width: 56px;
    height: 56px;
    border-radius: 16px;
    background: var(--primary);
    color: #fff;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    margin-bottom: 0.875rem;
    box-shadow: 0 8px 20px color-mix(in srgb, var(--primary) 30%, transparent);
  }
  .cta-card h2 {
    font-size: 1.25rem;
    margin-bottom: 0.5rem;
  }
  .cta-card p {
    color: var(--fg-muted);
    font-size: 0.9rem;
    line-height: 1.55;
    margin-bottom: 1rem;
  }

  .bismillah-strip {
    margin: 2rem 0 1rem;
    padding: 1.5rem 1rem;
    background: var(--bg-elev);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    text-align: center;
  }
  .bismillah-strip__arabic {
    font-family: var(--font-arabic);
    font-size: 1.4rem;
    color: var(--primary-strong);
    margin-bottom: 0.5rem;
    direction: rtl;
  }
  .bismillah-strip__translation {
    color: var(--fg-muted);
    font-style: italic;
    font-size: 0.85rem;
  }
</style>

<script>
  function escapeHtml(s) {
    return String(s ?? "").replace(/[&<>"']/g, (c) => ({
      "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;", "'": "&#39;",
    }[c]));
  }

  async function loadVerse() {
    const card = document.getElementById("verse-card");
    if (!card) return;
    card.innerHTML = `<div class="shimmer" style="height:80px;border-radius:8px"></div>`;
    try {
      const res = await fetch("/api/public/quran?random=1");
      if (!res.ok) throw new Error(`HTTP ${res.status}`);
      const data = await res.json();
      if (!data.ok || !data.verse) throw new Error("No verse");
      const v = data.verse;
      card.innerHTML = `
        <div class="daily-card__ref">Surah ${escapeHtml(v.surahNameEn)} · ${v.surah}:${v.ayah}</div>
        <div class="daily-card__arabic" dir="rtl" lang="ar">${escapeHtml(v.arabic)}</div>
        <div class="daily-card__translation">${escapeHtml(v.translation)}</div>
        ${v.transliteration ? `<div class="daily-card__source">${escapeHtml(v.transliteration)}</div>` : ""}
        <div class="daily-card__source">— ${escapeHtml(v.source ?? "Saheeh International")}</div>
      `;
    } catch (e) {
      card.innerHTML = `<div style="padding:1rem;color:var(--fg-muted);text-align:center;font-size:0.875rem">Could not load verse. Please refresh.</div>`;
    }
  }

  async function loadHadith() {
    const card = document.getElementById("hadith-card");
    if (!card) return;
    card.innerHTML = `<div class="shimmer" style="height:80px;border-radius:8px"></div>`;
    try {
      const res = await fetch("/api/public/hadith?random=1");
      if (!res.ok) throw new Error(`HTTP ${res.status}`);
      const data = await res.json();
      if (!data.ok || !data.hadith) throw new Error("No hadith");
      const h = data.hadith;
      card.innerHTML = `
        <div class="daily-card__ref">${escapeHtml(h.collection)} · #${escapeHtml(h.hadithNumber)}${h.grade ? " · " + escapeHtml(h.grade) : ""}</div>
        ${h.narratorEn ? `<div class="daily-card__narrator">Narrated by ${escapeHtml(h.narratorEn)}</div>` : ""}
        <div class="daily-card__arabic" dir="rtl" lang="ar">${escapeHtml(h.textAr ?? "")}</div>
        <div class="daily-card__translation">${escapeHtml(h.textEn)}</div>
        ${h.source ? `<div class="daily-card__source">— ${escapeHtml(h.source)}</div>` : ""}
      `;
    } catch (e) {
      card.innerHTML = `<div style="padding:1rem;color:var(--fg-muted);text-align:center;font-size:0.875rem">Could not load hadith.</div>`;
    }
  }

  async function loadDhikr() {
    const card = document.getElementById("dhikr-card");
    if (!card) return;
    card.innerHTML = `<div class="shimmer" style="height:80px;border-radius:8px"></div>`;
    try {
      const res = await fetch("/api/public/adhkar?random=1");
      if (!res.ok) throw new Error(`HTTP ${res.status}`);
      const data = await res.json();
      if (!data.ok || !data.dhikr) throw new Error("No dhikr");
      const d = data.dhikr;
      card.innerHTML = `
        <div class="daily-card__ref">${escapeHtml(d.category)} · repeat ×${escapeHtml(d.repeatCount)}</div>
        <div class="daily-card__arabic" dir="rtl" lang="ar">${escapeHtml(d.arabic)}</div>
        ${d.transliteration ? `<div class="daily-card__translation" style="font-style:italic">${escapeHtml(d.transliteration)}</div>` : ""}
        <div class="daily-card__translation">${escapeHtml(d.translation)}</div>
        ${d.source ? `<div class="daily-card__source">— ${escapeHtml(d.source)}</div>` : ""}
      `;
    } catch (e) {
      card.innerHTML = `<div style="padding:1rem;color:var(--fg-muted);text-align:center;font-size:0.875rem">Could not load dhikr.</div>`;
    }
  }

  function spin(btn) {
    btn.classList.add("spinning");
    setTimeout(() => btn.classList.remove("spinning"), 600);
  }

  document.getElementById("refresh-verse")?.addEventListener("click", (e) => {
    spin(e.currentTarget);
    loadVerse();
  });
  document.getElementById("refresh-hadith")?.addEventListener("click", (e) => {
    spin(e.currentTarget);
    loadHadith();
  });
  document.getElementById("refresh-dhikr")?.addEventListener("click", (e) => {
    spin(e.currentTarget);
    loadDhikr();
  });

  loadVerse();
  loadHadith();
  loadDhikr();
</script>
